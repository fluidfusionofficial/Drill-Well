# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nwis:nwis_dev@localhost:5432/nwis

# Synchronous URL used by Alembic migrations (psycopg2 driver)
SYNC_DATABASE_URL=postgresql+psycopg2://nwis:nwis_dev@localhost:5432/nwis

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=NWIS
API_PREFIX=/api
DEBUG=false

# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Local path where uploaded source documents are stored
STORAGE_PATH=./storage/uploads

# ── Auth (JWT) ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External services (optional) ──────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
